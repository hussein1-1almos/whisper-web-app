[Unit]
Description=Iraqi Arabic Voice Intelligence FastAPI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=voiceapp
Group=voiceapp
WorkingDirectory=/opt/voice_summrizer
EnvironmentFile=-/opt/voice_summrizer/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/voice_summrizer/.venv/bin/uvicorn iraqi_listener:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
